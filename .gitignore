# Dependencies
node_modules/
.pnpm-store/

# Build output.
#
# NOTE: lib/ is deliberately NOT ignored. This plugin is installed straight from
# a git tag (`dsh plugin --profile <p> add github:lifeopsgo/dsh-capability-toggle-plugin#vX.Y.Z`),
# and a git-hosted install has no build step unless pnpm is granted permission to
# run the package's prepare script — which every user would then have to allow by
# hash in their profile's pnpm-workspace.yaml. Shipping the built lib/ in the tag
# keeps installation to one command with no allowBuilds entry, the same way other
# published DSH plugins do it. Source maps stay out to keep the repo small.
lib/*.js.map
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.*
!.env.example

# Local scratch notes (review drafts, ad-hoc dumps)
CR.txt
*.local
tmp/
.cache/

# Test / coverage artifacts
coverage/
.nyc_output/
